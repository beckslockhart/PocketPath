<?xml version="1.0" encoding="utf-8"?>
<!-- one of the four areas of the path score with its points and the reason -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- a tick, warning or cross on a coloured circle -->
    <TextView
        android:id="@+id/tvPartStatus"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_circle"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:backgroundTint="#2E7D32"
        tools:text="✓" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPartName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#123F43"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Monthly goal" />

            <TextView
                android:id="@+id/tvPartPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#123F43"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="25 / 25" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressPart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="25"
            app:indicatorTrackGapSize="0dp"
            app:trackColor="#E3ECEA"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            app:trackStopIndicatorSize="0dp"
            tools:indicatorColor="#2E7D32"
            tools:progress="25" />

        <TextView
            android:id="@+id/tvPartReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#405957"
            android:textSize="13sp"
            tools:text="You've spent R2,100.00 this month, between your R1,000.00 minimum and R5,000.00 maximum." />

    </LinearLayout>

</LinearLayout>
