<?xml version="1.0" encoding="utf-8"?>
<!-- Displays one expense inside the Expense History list. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/expenseCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="#D8E5E3"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Main expense information. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvExpenseDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#123F43"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Weekly grocery shop" />

                <TextView
                    android:id="@+id/tvExpenseCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#607372"
                    android:textSize="13sp"
                    tools:text="Groceries" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvExpenseAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#176B66"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="R450.00" />

        </LinearLayout>

        <!-- Date and time recorded for the expense. -->
        <TextView
            android:id="@+id/tvExpenseDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:textColor="#607372"
            android:textSize="13sp"
            tools:text="14 Sep 2026  ·  09:30 – 10:15" />

        <!-- Preview displayed when an attachment is available. -->
        <ImageView
            android:id="@+id/imgExpensePhoto"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:background="#E8F3F1"
            android:clipToOutline="true"
            android:contentDescription="@string/expense_photograph_preview"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:src="@drawable/ic_receipt_placeholder"
            tools:visibility="visible" />

        <!-- Opens the saved attachment in the viewer. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewPhoto"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/view_photograph"
            android:textColor="#176B66"
            android:visibility="gone"
            app:iconTint="#176B66"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:orientation="horizontal">

            <!-- Deletes the selected expense after confirmation. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteExpense"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textColor="#C43D3D" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>